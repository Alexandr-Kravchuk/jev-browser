{
  "name": "TodoMVC: add, complete, filter, clear",
  "url": "https://demo.playwright.dev/todomvc/",
  "steps": [
    { "goal": "Add a todo item", "values": { "todo": "buy milk" },
      "assert": "() => document.querySelectorAll('.todo-list li').length === 1" },
    { "goal": "Add a todo item", "values": { "todo": "walk the dog" },
      "assert": "() => document.querySelectorAll('.todo-list li').length === 2" },
    { "goal": "Mark the 'buy milk' todo as completed",
      "assert": "() => [...document.querySelectorAll('.todo-list li.completed')].map(l => l.innerText.trim()).join('|') === 'buy milk'" },
    { "goal": "Show only the completed todos",
      "assert": "() => location.hash.includes('completed')" },
    { "goal": "Clear all completed todos",
      "assert": "() => document.querySelectorAll('.todo-list li').length === 0" }
  ]
}
